@@ -0,0 +1,227 @@
+"""Offline tests for the fail-closed WebAuthn approval evaluator.
+
+All fixtures are synthetic markers, never real credentials or key material.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+
+import pytest
+
+from personal_ai_execution import approval_webauthn as aw
+
+
+def _b64url(data: bytes) -> str:
+    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")
+
+
+SYNTHETIC_CREDENTIAL_ID = b"SYNTHETIC-CREDENTIAL-ID-FIXTURE"
+SYNTHETIC_PUBLIC_KEY = b"SYNTHETIC-PUBLIC-KEY-FIXTURE-NOT-A-KEY"
+RP_ID = "approval.example.test"
+ORIGIN = "https://approval.example.test"
+CHALLENGE = "synthetic-challenge-fixture"
+ALG = -7
+
+
+def _credential_document(*, credential_id: bytes = SYNTHETIC_CREDENTIAL_ID,
+                         public_key: bytes = SYNTHETIC_PUBLIC_KEY,
+                         user_verification: str = "required") -> dict:
+    return {
+        "credential_id": _b64url(credential_id),
+        "public_key": _b64url(public_key),
+        "rp_id": RP_ID,
+        "alg": ALG,
+        "user_verification": user_verification,
+    }
+
+
+def _authenticator_data(*, rp_id: str = RP_ID, user_present: bool = True,
+                        user_verified: bool = True, counter: int = 1) -> bytes:
+    flags = 0
+    if user_present:
+        flags |= aw.FLAG_USER_PRESENT
+    if user_verified:
+        flags |= aw.FLAG_USER_VERIFIED
+    return (
+        hashlib.sha256(rp_id.encode()).digest()
+        + bytes([flags])
+        + counter.to_bytes(4, "big")
+    )
+
+
+def _client_data(*, challenge: str = CHALLENGE, origin: str = ORIGIN,
+                 type_: str = "webauthn.get") -> bytes:
+    return json.dumps(
+        {"type": type_, "challenge": challenge, "origin": origin}
+    ).encode("utf-8")
+
+
+def _verifier(public_key, message, signature, alg):  # noqa: ANN001
+    return signature != b"SYNTHETIC-BAD-SIGNATURE"
+
+
+class _Ledger:
+    def __init__(self, status: str = aw.REASON_OK) -> None:
+        self.status = status
+        self.used: set[str] = set()
+
+    def consume(self, challenge: str) -> str:
+        if self.status != aw.REASON_OK:
+            return self.status
+        if challenge in self.used:
+            return aw.REASON_CHALLENGE_CONSUMED
+        self.used.add(challenge)
+        return aw.REASON_OK
+
+
+def _evaluate(**overrides):  # noqa: ANN003
+    credentials = overrides.pop(
+        "credentials",
+        [aw.parse_approval_credentials([_credential_document()])[0]],
+    )
+    params = dict(
+        credentials=credentials,
+        client_data_json=_client_data(),
+        authenticator_data=_authenticator_data(),
+        signature=b"synthetic-signature",
+        credential_id=SYNTHETIC_CREDENTIAL_ID,
+        expected_challenge=CHALLENGE,
+        expected_origins=(ORIGIN,),
+        signature_verifier=_verifier,
+        challenge_consume=_Ledger().consume,
+        stored_counters=None,
+    )
+    params.update(overrides)
+    return aw.evaluate_assertion(**params)
+
+
+def test_parse_accepts_list_and_object_wrapper() -> None:
+    assert aw.parse_approval_credentials([_credential_document()])[0]["rp_id"] == RP_ID
+    wrapped = aw.parse_approval_credentials({"credentials": [_credential_document()]})
+    assert wrapped[0]["credential_id"] == SYNTHETIC_CREDENTIAL_ID
+
+
+def test_parse_normalizes_standard_base64_and_padding() -> None:
+    standard = {
+        "credential_id": base64.b64encode(SYNTHETIC_CREDENTIAL_ID).decode(),
+        "public_key": base64.b64encode(SYNTHETIC_PUBLIC_KEY).decode(),
+        "rp_id": RP_ID,
+        "alg": ALG,
+    }
+    parsed = aw.parse_approval_credentials([standard])
+    assert parsed[0]["credential_id"] == SYNTHETIC_CREDENTIAL_ID
+    assert parsed[0]["public_key"] == SYNTHETIC_PUBLIC_KEY
+
+
+@pytest.mark.parametrize(
+    "raw, reason",
+    [
+        ("{not json", aw.REASON_CREDENTIALS_PARSE_ERROR),
+        (42, aw.REASON_CREDENTIALS_SCHEMA_ERROR),
+        ([], aw.REASON_CREDENTIALS_SCHEMA_ERROR),
+        ([{"rp_id": RP_ID}], aw.REASON_CREDENTIALS_SCHEMA_ERROR),
+        ([dict(_credential_document(), credential_id="!!!")],
+         aw.REASON_CREDENTIAL_ID_ENCODING_ERROR),
+        ([dict(_credential_document(), public_key="***")],
+         aw.REASON_PUBLIC_KEY_ENCODING_ERROR),
+    ],
+)
+def test_parse_rejects_invalid_documents(raw, reason) -> None:  # noqa: ANN001
+    with pytest.raises(aw.ApprovalConfigError) as excinfo:
+        aw.parse_approval_credentials(raw)
+    assert excinfo.value.reason == reason
+    assert excinfo.value.code == aw.ERROR_CODE
+
+
+def test_full_chain_success_returns_exactly_one_reason() -> None:
+    result = _evaluate()
+    assert result["ok"] is True
+    assert result["reason"] == aw.REASON_OK
+    assert result["code"] is None
+
+
+def test_challenge_mismatch_is_localized() -> None:
+    result = _evaluate(expected_challenge="different-challenge")
+    assert result["reason"] == aw.REASON_CHALLENGE_MISMATCH
+    assert result["stage"] == "challenge"
+
+
+def test_origin_mismatch_is_localized() -> None:
+    result = _evaluate(expected_origins=("https://other.example.test",))
+    assert result["reason"] == aw.REASON_ORIGIN_MISMATCH
+
+
+def test_rp_id_mismatch_is_localized() -> None:
+    result = _evaluate(authenticator_data=_authenticator_data(rp_id="other.test"))
+    assert result["reason"] == aw.REASON_RP_ID_MISMATCH
+
+
+def test_user_verification_required_but_absent() -> None:
+    result = _evaluate(
+        authenticator_data=_authenticator_data(user_verified=False)
+    )
+    assert result["reason"] == aw.REASON_USER_VERIFICATION_REQUIRED
+
+
+def test_user_presence_required_but_absent() -> None:
+    result = _evaluate(
+        client_data_json=_client_data(),
+        authenticator_data=_authenticator_data(user_present=False, user_verified=False),
+    )
+    assert result["reason"] == aw.REASON_USER_PRESENCE_REQUIRED
+
+
+def test_credential_not_found_is_localized() -> None:
+    result = _evaluate(credential_id=b"other-credential")
+    assert result["reason"] == aw.REASON_CREDENTIAL_NOT_FOUND
+
+
+def test_signature_invalid_is_localized() -> None:
+    result = _evaluate(signature=b"SYNTHETIC-BAD-SIGNATURE")
+    assert result["reason"] == aw.REASON_SIGNATURE_INVALID
+
+
+def test_counter_regression_is_localized() -> None:
+    result = _evaluate(
+        authenticator_data=_authenticator_data(counter=5),
+        stored_counters={SYNTHETIC_CREDENTIAL_ID: 9},
+    )
+    assert result["reason"] == aw.REASON_COUNTER_REGRESSION
+
+
+def test_replay_is_rejected_by_atomic_consume() -> None:
+    ledger = _Ledger()
+    first = _evaluate(challenge_consume=ledger.consume)
+    second = _evaluate(challenge_consume=ledger.consume)
+    assert first["ok"] is True
+    assert second["ok"] is False
+    assert second["reason"] == aw.REASON_CHALLENGE_CONSUMED
+
+
+@pytest.mark.parametrize(
+    "status",
+    [aw.REASON_CHALLENGE_NOT_FOUND, aw.REASON_CHALLENGE_EXPIRED],
+)
+def test_ledger_status_reasons_are_forwarded(status: str) -> None:
+    result = _evaluate(challenge_consume=_Ledger(status).consume)
+    assert result["reason"] == status
+
+
+def test_result_never_contains_raw_material() -> None:
+    serialized = json.dumps(_evaluate(), sort_keys=True)
+    for token in (
+        _b64url(SYNTHETIC_CREDENTIAL_ID),
+        _b64url(SYNTHETIC_PUBLIC_KEY),
+        CHALLENGE,
+        "synthetic-signature",
+    ):
+        assert token not in serialized
+
+
+def test_reason_vocabulary_is_complete_and_unique() -> None:
+    assert len(aw.REASON_VOCABULARY) == len(set(aw.REASON_VOCABULARY))
+    assert aw.ERROR_CODE == "APPROVAL_CREDENTIALS_INVALID"
+    assert aw.REASON_OK in aw.REASON_VOCABULARY
